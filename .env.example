VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Web Push (Phase 4) – oeffentlicher VAPID-Schluessel, Gegenstueck zum
# privaten Schluessel, den die Edge Function "send-push-notification" als
# Secret VAPID_PRIVATE_KEY nutzt. Generieren: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=YOUR-VAPID-PUBLIC-KEY
